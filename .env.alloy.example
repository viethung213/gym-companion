# ==============================================================================
# GRAFANA CLOUD & ALLOY TELEMETRY CREDENTIALS
# Điền các giá trị lấy từ Grafana Cloud Portal -> gymcompanion Stack -> Details
# ==============================================================================

# 1. Token chung (sinh từ Access Policies với quyền: metrics:write, logs:write, traces:write)
GRAFANA_CLOUD_TOKEN=glc_eyJvIjoi...

# 2. Prometheus / Mimir (Metrics)
GRAFANA_METRICS_USER=123456
GRAFANA_METRICS_URL=https://prometheus-prod-122-prod-ap-southeast-1.grafana.net/api/prom/push

# 3. Loki (Logs)
GRAFANA_LOGS_USER=123123
GRAFANA_LOGS_URL=https://logs-prod-123.grafana.net/loki/api/v1/push

# 4. Tempo (Traces - OTLP gRPC port 443)
GRAFANA_TRACES_USER=982313
GRAFANA_TRACES_ENDPOINT=tempo-prod-12-prod-ap-southeast-1.grafana.net:443

# 5. Khóa xác thực Admin Gateway để Alloy kéo metrics từ gateway:8001/metrics
ADMIN_KEY=your_gateway_admin_secret_key

