# Application Configurations
APP_ENV=development
APP_PORT=8080
GRPC_PORT=9090

# =====================================================================
# TRƯỜNG HỢP 1: Chạy APP trong mạng Docker (Test Environment)
# (Các host trỏ đến tên Service trong các docker-compose thành phần)
# =====================================================================
DATABASE_URL=postgres://postgres:postgres@postgres:5432/fitai?sslmode=disable

KAFKA_BROKERS=fitai-kafka-01-dangviethung213-8db9.i.aivencloud.com:24232
KAFKA_CLIENT_ID=fitai-backend
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USER=avnadmin
KAFKA_PASSWORD=your-aiven-kafka-password
# KAFKA_CA_CERT_PATH=./ca.pem


# Security Configuration
JWT_SECRET=your-jwt-secret-key-minimum-32-characters
JWT_ISSUER=fitai-app
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
JWT_KEY_ROTATION_TTL=168h
OAUTH_STATE_SECRET=your-oauth-state-secret-key-minimum-32-characters

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# Facebook OAuth Configuration
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/oauth/callback

# Google ADK / Gemini Configuration
GOOGLE_API_KEY=your-google-gemini-api-key-here
# Model chính ưu tiên sử dụng (Mặc định: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Danh sách các model dự phòng phân tách bằng dấu phẩy, tự động kích hoạt khi model chính cạn Quota / 429 Rate Limit
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash-lite,gemini-1.5-flash

# Cloud Storage / Supabase S3 Configuration
# CDN public URL is auto-derived from AWS_S3_ENDPOINT (strip /s3 -> /object/public/<bucket>)
AWS_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
AWS_S3_BUCKET=gym-companion-assets
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-supabase-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key

# Default ONNX Model URLs for New Exercise Drafts
DEFAULT_ONNX_DETECTOR_URL=https://storage.supabase.co/storage/v1/object/public/detectors/yolox_tiny.onnx
DEFAULT_ONNX_SKELETON_URL=https://storage.supabase.co/storage/v1/object/public/skeletons/rtmpose_s.onnx


