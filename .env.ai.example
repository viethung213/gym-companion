# =====================================================================
# AI & NOTIFICATION SERVICE ENVIRONMENT CONFIGURATION (.env.ai)
# Manages: coaching, nutrition, notification
# =====================================================================

# Application Configurations
APP_ENV=development
SERVICE_ID=ai-notification-service
APP_PORT=8082
GRPC_PORT=9092
INTERNAL_SECRET=gym-companion-internal-secret-2026-key
GATEWAY_URL=http://localhost:8000
# Gateway Control Plane URL for Service Discovery
# Khi chạy app trực tiếp từ host máy cá nhân không qua Docker network:
GATEWAY_ADMIN_URL=http://localhost:8001
# Khi chạy trong Docker network:
# GATEWAY_ADMIN_URL=http://fitai-gateway:8001
GATEWAY_ADMIN_KEY=gym-companion-admin-secret-2026

# Database Configuration (Dedicated AI Database)
# Fallback priority: <MODULE>_DATABASE_URL > AI_DATABASE_URL > DATABASE_URL
# Chạy trong Docker network (Test Environment / Docker Compose):
DATABASE_URL=postgres://postgres:postgres@postgres:5432/fitai?sslmode=disable
# Khi chạy app trực tiếp từ host máy cá nhân không qua Docker network:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitai_ai?sslmode=disable

# Module-specific Database Overrides (Optional)
# COACHING_DATABASE_URL=
# NUTRITION_DATABASE_URL=
# NOTIFICATION_DATABASE_URL=

# Message Broker (Kafka)
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=fitai-backend
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_USER=your-kafka-user
# KAFKA_PASSWORD=your-kafka-password
# KAFKA_CA_CERT_PATH=./ca.pem
# KAFKA_INSECURE_SKIP_VERIFY=true

# Redis Configuration (Optional Rate Limiting / Cache)
REDIS_ADDR=redis:6379
# Khi chạy app trực tiếp từ host máy cá nhân không qua Docker network:
# REDIS_ADDR=127.0.0.1:6379

# AI Provider: gemini | groq (Mặc định: groq)
AI_PROVIDER=groq

# Groq API Configuration
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
AI_MAX_OUTPUT_TOKENS=8192

# Google ADK / Gemini Configuration (API Key riêng cho từng module)
GOOGLE_API_KEY_COACHING=your-google-gemini-api-key-for-coaching
GOOGLE_API_KEY_NUTRITION=your-google-gemini-api-key-for-nutrition
# Model chính ưu tiên sử dụng (Mặc định: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Danh sách các model dự phòng phân tách bằng dấu phẩy, tự động kích hoạt khi model chính cạn Quota / 429 Rate Limit
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash-lite,gemini-1.5-flash

# Firebase Cloud Messaging (FCM) Notification Configuration
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-fbsvc@your-firebase-project-id.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FCM_PRIVATE_KEY_ID=your-private-key-id
FCM_CLIENT_ID=your-client-id
FCM_SERVER_KEY=your-firebase-fcm-oauth2-token-or-key

