{
  "display_name": "Shoulder Press",
  "rep_type": "counted",
  "notes": "Bài tập đẩy vai qua đầu. Bắt đầu từ ngang vai (góc khuỷu tay ≤90°) và đẩy thẳng lên qua đầu (≥158°).",
  "phase_detection": {
    "metric": "elbow_angle",
    "thresholds": {
      "rest": {
        "lte": 98,
        "comment": "Vị trí chuẩn bị ngang vai (khuỷu tay gập ≤98°)"
      },
      "transition": {
        "gt": 98,
        "lt": 148,
        "comment": "Đang đẩy tạ lên hoặc hạ tạ xuống"
      },
      "active": {
        "gte": 148,
        "comment": "Đỉnh rep: Tay đẩy thẳng qua đầu"
      }
    },
    "calculation": {
      "landmarks": [
        "Shoulder (P5, P6)",
        "Elbow (P7, P8)",
        "Wrist (P9, P10)"
      ],
      "formula": "θ = arccos((U · W) / (||U|| * ||W||)) * (180 / π)"
    }
  },
  "rules": [
    {
      "metric": "wrist_symmetry",
      "description": "Chênh lệch độ cao hai tay khi đẩy vai",
      "evaluation_type": "upper_bound",
      "apply_in_phases": ["transition", "active"],
      "apply_for_view": "front",
      "ranges": [
        {
          "severity": 0,
          "status": "Correct",
          "min": 0.0,
          "max": 0.20
        },
        {
          "severity": 1,
          "status": "Warning",
          "min": 0.20,
          "max": 0.30
        },
        {
          "severity": 2,
          "status": "Danger",
          "min": 0.30,
          "max": null
        }
      ],
      "calculation": {
        "landmarks": [
          "Left Wrist (P9)",
          "Right Wrist (P10)"
        ],
        "formula": "wrist_symmetry = |Y_wrist_left - Y_wrist_right| / torso_length"
      }
    },
    {
      "metric": "spine_sway_angle",
      "description": "Ngửa lưng quá mức khi đẩy tạ qua đầu",
      "evaluation_type": "upper_bound",
      "apply_in_phases": ["transition", "active"],
      "apply_for_view": "all",
      "ranges": [
        {
          "severity": 0,
          "status": "Correct",
          "min": 0.0,
          "max": 12.0
        },
        {
          "severity": 1,
          "status": "Warning",
          "min": 12.0,
          "max": 20.0
        },
        {
          "severity": 2,
          "status": "Danger",
          "min": 20.0,
          "max": null
        }
      ],
      "calculation": {
        "landmarks": [
          "Shoulder (P5, P6)",
          "Hip (P11, P12)"
        ],
        "formula": "spine_sway_angle = atan2(|X_shoulder - X_hip|, |Y_shoulder - Y_hip|) * (180 / π)"
      }
    }
  ]
}
