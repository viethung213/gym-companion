# =====================================================================
# CORE SERVICE ENVIRONMENT CONFIGURATION (.env.core)
# Manages: auth, exercise, workout_execution, profile, social, solo_match, gamification
# =====================================================================

# Application Configurations
APP_ENV=development
APP_PORT=8080
GRPC_PORT=9090
INTERNAL_SECRET=gym-companion-internal-secret-2026-key

# Database Configuration (Dedicated Core Database)
# Fallback priority: <MODULE>_DATABASE_URL > CORE_DATABASE_URL > DATABASE_URL
# Chạy trong Docker network (Test Environment / Docker Compose):
DATABASE_URL=postgres://postgres:postgres@postgres:5432/fitai?sslmode=disable
# Khi chạy app trực tiếp từ host máy cá nhân không qua Docker network:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitai_core?sslmode=disable

# Module-specific Database Overrides (Optional)
# AUTH_DATABASE_URL=
# EXERCISE_DATABASE_URL=
# WORKOUT_EXECUTION_DATABASE_URL=
# PROFILE_DATABASE_URL=
# SOCIAL_DATABASE_URL=
# SOLO_MATCH_DATABASE_URL=
# GAMIFICATION_DATABASE_URL=

# Message Broker (Kafka)
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=fitai-backend
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_USER=your-kafka-user
# KAFKA_PASSWORD=your-kafka-password
# KAFKA_CA_CERT_PATH=./ca.pem
# KAFKA_INSECURE_SKIP_VERIFY=true

# Redis Configuration (Matchmaking Queue & PubSub)
REDIS_ADDR=redis:6379
# Khi chạy app trực tiếp từ host máy cá nhân không qua Docker network:
# REDIS_ADDR=127.0.0.1:6379

# Security Configuration
JWT_SECRET=your-jwt-secret-key-minimum-32-characters
JWT_ISSUER=fitai-app
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
JWT_KEY_ROTATION_TTL=168h
OAUTH_STATE_SECRET=your-oauth-state-secret-key-minimum-32-characters

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# Facebook OAuth Configuration
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/oauth/callback

# Cloud Storage / Supabase S3 Configuration
AWS_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
AWS_S3_BUCKET=gym-companion-assets
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-supabase-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key

# Default ONNX Model URLs for New Exercise Drafts
DEFAULT_ONNX_DETECTOR_URL=https://storage.supabase.co/storage/v1/object/public/detectors/yolox_tiny.onnx
DEFAULT_ONNX_SKELETON_URL=https://storage.supabase.co/storage/v1/object/public/skeletons/rtmpose_s.onnx

