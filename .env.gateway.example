# ==============================================================================
# GYM COMPANION - API GATEWAY ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file contains configuration variables exclusively for the Custom API Gateway (cmd/gateway).
# Copy this file to .env.gateway for local development or set these variables in production.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development

# Port where API Gateway listens for external traffic (HTTP/1.1 and HTTP/2 h2c)
# Default: 8000
GATEWAY_PORT=8000

# Path to the JSON dynamic routing configuration file
# For production / default: configs/gateway_routes.json
# For docker compose / test: configs/gateway_routes.docker.json
GATEWAY_CONFIG_PATH=configs/gateway_routes.json

# Zero-Trust Internal Secret Key for HMAC-SHA256 Token Translation
# MUST MATCH the INTERNAL_SECRET configured across Core and AI backend microservices!
# In production, use a secure 32+ character cryptographically random string.
INTERNAL_SECRET=gym-companion-internal-secret-2026-key

# Time-To-Live (TTL) for short-lived X-Internal-Token
# Format: duration string (e.g., 30s, 1m, 2m)
# Default: 1m (60 seconds)
TOKEN_TTL=1m

# Hot-Reload Config Watcher Polling Interval
# Frequency to scan GATEWAY_CONFIG_PATH for in-memory dynamic route updates
# Format: duration string (e.g., 1s, 2s, 5s)
# Default: 2s
WATCH_INTERVAL=2s

# Strict TLS/HTTPS Enforcement Flag
# When true: Gateway strictly requires HTTPS (r.TLS != nil or X-Forwarded-Proto=https).
# Non-TLS requests will be rejected with HTTP 426 Upgrade Required and HSTS header attached.
# Default for dev: false | Recommended for prod: true
ENFORCE_TLS=false

# ==============================================================================
# GATEWAY ADMIN & OBSERVABILITY CONTROL PLANE CONFIGURATION
# ==============================================================================
# Port for Admin & Observability HTTP Server (Internal Port Isolation)
GATEWAY_ADMIN_PORT=8001

# Admin API Key required in X-Admin-Key header for management endpoints
GATEWAY_ADMIN_KEY=gym-companion-admin-secret-2026

# Enable or disable the Admin Control Plane server (true | false)
GATEWAY_ADMIN_ENABLED=true

# In-Memory Ring Buffer size for Request Journey Traces
GATEWAY_TRACE_BUFFER_SIZE=2000


